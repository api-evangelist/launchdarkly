{
  "opencollection": "1.0.0",
  "info": {
    "name": "LaunchDarkly Relay Proxy Access Tokens PHP Polling API",
    "version": "8.0"
  },
  "items": [
    {
      "info": {
        "name": "PHP Polling",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get latest all flags (PHP polling)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8030/sdk/latest-all",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns the latest flag data for PHP server-side SDKs that use polling mode instead of streaming. Requires an SDK key in the Authorization header."
        }
      ]
    }
  ],
  "bundled": true
}
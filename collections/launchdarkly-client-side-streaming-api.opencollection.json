            "params": [
              {
                "name": "envId",
                "value": "",
                "type": "path",
                "description": "The client-side environment ID."
              },
              {
                "name": "contextBase64",
                "value": "",
                "type": "path",
                "description": "A base64-encoded JSON representation of the evaluation context."
              }
            ]
          },
          "docs": "Establishes a Server-Sent Events (SSE) stream that delivers evaluated flag values for the given context to client-side SDKs."
